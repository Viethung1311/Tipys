{
  "framework": "vite",
  "buildCommand": "npm run build && npm test",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/classroom",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ],
  "regions": ["sin1"]
}
